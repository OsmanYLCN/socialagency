# ─── Supabase API Bağlantı Bilgileri ───────────────────────────────────────────
# Supabase Dashboard -> Project Settings -> API bölümünden alınabilir
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ─── Prisma & PostgreSQL Veritabanı Bağlantısı ─────────────────────────────────
# Supabase Dashboard -> Project Settings -> Database bölümünden alınabilir
# Connection Pooling (Port 6543) - Transaction modunda Prisma sorguları için:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) - Prisma migrasyonları için:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
